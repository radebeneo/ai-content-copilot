@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.HomePage>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.SiteTitle ?? "Welcome";
    ViewData["Description"] = Model.SiteSubtitle;
    
    // Fetch latest news articles from the NewsLandingPage node dynamically
    var newsLanding = Model.Root().FirstChild<ContentModels.NewsLandingPage>();
    var articles = newsLanding?.Children<ContentModels.NewsDetail>().Take(3).ToList() ?? new List<ContentModels.NewsDetail>();
}

@section Styles {
    <link rel="stylesheet" href="/css/homepage.css" />
}

<!-- Hero Section -->
<section class="hero">
    <div class="container">
        <span class="badge-live hp-badge">FIFA World Cup 2026</span>
        <h1>@Model.SiteTitle</h1>
        <p>@Model.SiteSubtitle. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aliquam at porttitor sem. Curabitur sed nisl eget elit mollis at feugiat urna sodales. Aliquam erat volutpat.</p>
        <div class="hp-hero-cta-container">
            @if (newsLanding != null)
            {
                <a href="@newsLanding.Url()" class="cta-button">Read News Feed</a>
            }
        </div>
    </div>
</section>

<!-- Countdown & Quick Stats -->
<section class="hp-stats-section">
    <div class="container hp-stats-container">
        <div>
            <h3 class="hp-stat-number-primary">48</h3>
            <p class="hp-stat-label">Teams Competing</p>
        </div>
        <div>
            <h3 class="hp-stat-number-accent">16</h3>
            <p class="hp-stat-label">Host Cities</p>
        </div>
        <div>
            <h3 class="hp-stat-number-secondary">104</h3>
            <p class="hp-stat-label">Total Matches</p>
        </div>
        <div>
            <h3 class="hp-stat-number-danger">3</h3>
            <p class="hp-stat-label">Host Nations</p>
        </div>
    </div>
</section>

<!-- Latest News Section -->
<section class="container hp-news-section">
    <div class="hp-news-header">
        <div>
            <h2 class="hp-section-title">Featured Coverage</h2>
            <p class="hp-section-subtitle">Stay ahead with the latest analysis and tournament breaking news.</p>
        </div>
        @if (newsLanding != null)
        {
            <a href="@newsLanding.Url()" class="hp-view-all-link">
                View All News 
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
        }
    </div>

    <div class="news-grid">
        @* ── Static article ── *@
        <article class="news-card">
            <div class="card-image-wrapper">
                <img src="/media/mex-rsa.jpeg" alt="The World Cup Tournament Kicks Off in Mexico City" />
                <span class="card-badge">News</span>
            </div>
            <div class="card-content">
                <div class="card-date">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    May 27, 2026
                </div>
                <h3 class="card-title"><a href="#">The World Cup Tournament Kicks Off in Mexico City</a></h3>
                <p class="card-excerpt">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Cras interdum pretium purus. Morbi convallis imperdiet leo eget porta.</p>
                <a href="#" class="card-link">
                    Read Article
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
            </div>
        </article>
    </div>
</section>

<!-- Host Cities Section -->
<section id="tournament-info" class="hp-tournament-info-section">
    <div class="container">
        <div class="hp-tournament-header">
            <h2 class="hp-section-title">Three Nations, One Tournament</h2>
            <p class="hp-tournament-subtitle">For the first time in history, the FIFA World Cup will be hosted across 16 cities in Canada, Mexico, and the United States.</p>
        </div>

        <div class="hp-nations-grid">
            <div class="hp-nation-card">
                <h3 class="hp-nation-title-primary">United States</h3>
                <p class="hp-nation-desc">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation.</p>
                <div class="hp-nation-footer">11 Host Cities</div>
            </div>
            <div class="hp-nation-card">
                <h3 class="hp-nation-title-accent">Mexico</h3>
                <p class="hp-nation-desc">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Proin nibh nisl condimentum id venenatis a. Est placerat in egestas erat imperdiet sed euismod nisi porta lacing.</p>
                <div class="hp-nation-footer">3 Host Cities</div>
            </div>
            <div class="hp-nation-card">
                <h3 class="hp-nation-title-secondary">Canada</h3>
                <p class="hp-nation-desc">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nullam in dui mauris. Vivamus hendrerit arcu sed erat molestie vehicula. Sed auctor neque eu pretium finibus.</p>
                <div class="hp-nation-footer">2 Host Cities</div>
            </div>
        </div>
    </div>
</section>
