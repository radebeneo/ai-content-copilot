@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.NewsLandingPage>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Heading ?? "World Cup News";
    ViewData["Description"] = "Stay updated with the latest news, expert analysis, and updates for the FIFA World Cup 2026.";
    
    // Fetch all child news details dynamically
    var articles = Model.Children<ContentModels.NewsDetail>().ToList();
}

<section class="container" style="padding-top: 60px;">
    <!-- Page Header -->
    <div style="border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 24px; margin-bottom: 40px;">
        <span class="badge-live" style="margin-bottom: 12px;">Exclusive Coverage</span>
        <h1 style="font-size: 48px; font-weight: 800;">@Model.Heading</h1>
        <p style="color: var(--text-muted); font-size: 18px; margin-top: 8px;">Breaking stories, match previews, and team insights for the 2026 World Cup.</p>
    </div>

    <!-- Main Grid Content -->
    <div class="article-body-wrapper">
        <!-- Main News Column -->
        <div>
            <div style="display: grid; grid-template-columns: 1fr; gap: 32px;">
                @if (articles.Any())
                {
                    @foreach (var article in articles)
                    {
                        var imgUrl = article.HeaderImage?.Url() ?? "/media/2gtdwgto/image.jpg";
                        <article class="news-card" style="flex-direction: row; min-height: 240px; @(articles.IndexOf(article) == 0 ? "border-color: var(--primary);" : "")">
                            <div class="card-image-wrapper" style="width: 35%; aspect-ratio: auto; min-height: 100%;">
                                <img src="@imgUrl" alt="@article.Heading" style="height: 100%; object-fit: cover;" />
                            </div>
                            <div class="card-content" style="width: 65%; padding: 24px;">
                                <div class="card-date">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                    @article.CreateDate.ToString("MMMM dd, yyyy")
                                    @if (articles.IndexOf(article) == 0)
                                    {
                                        <span class="badge-live" style="font-size: 9px; padding: 2px 6px; margin-left: 10px;">LATEST</span>
                                    }
                                </div>
                                <h2 style="font-size: 22px; margin-bottom: 8px; font-weight: 700; line-height: 1.3;">
                                    <a href="@article.Url()" style="color: white; hover: color: var(--primary);">@article.Heading</a>
                                </h2>
                                <p style="font-size: 14px; color: var(--text-muted); margin-bottom: 16px; flex-grow: 1;">
                                    @(string.IsNullOrEmpty(article.Subheading) ? "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Cras interdum pretium purus. Morbi convallis imperdiet leo eget porta." : article.Subheading)
                                </p>
                                <a href="@article.Url()" class="card-link">
                                    Read Full Story 
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </a>
                            </div>
                        </article>
                    }
                }
            </div>
        </div>
        
        <!-- Sidebar -->
        <aside class="article-sidebar">
            <h3 class="sidebar-title">Tournament Categories</h3>
            <ul class="sidebar-list" style="margin-bottom: 40px; display: flex; flex-direction: column; gap: 12px;">
                <li style="display: flex; justify-content: space-between; font-size: 14px;">
                    <a href="#" style="color: var(--primary);">Tournament News</a>
                    <span style="opacity: 0.5;">(14)</span>
                </li>
                <li style="display: flex; justify-content: space-between; font-size: 14px;">
                    <a href="#">Host Cities & Stadiums</a>
                    <span style="opacity: 0.5;">(8)</span>
                </li>
                <li style="display: flex; justify-content: space-between; font-size: 14px;">
                    <a href="#">Team Profiles</a>
                    <span style="opacity: 0.5;">(32)</span>
                </li>
                <li style="display: flex; justify-content: space-between; font-size: 14px;">
                    <a href="#">Ticket Information</a>
                    <span style="opacity: 0.5;">(5)</span>
                </li>
            </ul>

            <h3 class="sidebar-title">About the 2026 Edition</h3>
            <p style="font-size: 13px; color: var(--text-muted); line-height: 1.6; margin-bottom: 16px;">
                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Cras interdum pretium purus. Morbi convallis imperdiet leo eget porta. Pellentesque dictum accumsan pulvinar.
            </p>
            <p style="font-size: 13px; color: var(--text-muted); line-height: 1.6;">
                Aliquam at porttitor sem. Curabitur sed nisl eget elit mollis at feugiat urna sodales. Aliquam erat volutpat.
            </p>
        </aside>
    </div>
</section>
